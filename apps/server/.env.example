# HTTP port for the Nest API (see src/main-dev.ts)
PORT=3001

# Must match host port in docker-compose.yml (postgres service)
DATABASE_URL="postgresql://postgres:password@localhost:5440/proline?schema=public"

# Auth
CLIENT_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="15m"
JWT_COOKIE_MAX_AGE_MS=900000
JWT_COOKIE_SAME_SITE="lax"
JWT_COOKIE_SECURE=false
